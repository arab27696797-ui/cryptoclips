# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cryptoclips?schema=public"

# App Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-here-min-32-chars"

# OpenRouter AI Configuration
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_PRIMARY_MODEL="openai/gpt-4.1"
OPENROUTER_FALLBACK_MODEL="anthropic/claude-3.7-sonnet"

# Edge TTS Configuration (no API key needed - uses Microsoft Edge TTS)

# Billing Provider (mock for testing, tribute for production)
BILLING_PROVIDER="mock"

# Mock Billing (for testing only)
# No additional config needed

# Tribute Crypto Payments (for production - configure when ready)
# TRIBUTE_API_KEY="your-tribute-api-key"
# TRIBUTE_SECRET_KEY="your-tribute-secret-key"
# TRIBUTE_WEBHOOK_SECRET="your-tribute-webhook-secret"
# TRIBUTE_BASE_URL="https://api.tribute.com/v1"
# NEXT_PUBLIC_TRIBUTE_PUBLIC_KEY="your-tribute-public-key"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Video Rendering
FFMPEG_PATH="ffmpeg"
RENDER_OUTPUT_DIR="./renders"

# Session Configuration
SESSION_COOKIE_NAME="cryptoclips_session"
SESSION_MAX_AGE="2592000"
